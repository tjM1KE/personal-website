---
const skills = [
  "Python",
  "SQL",
  "Linux",
  "Docker",
  "Git",
  "Networking",
  "Data Analysis",
  "Mathematical Modelling",
];

const homelabStack = [
  "Ubuntu Server",
  "Docker Compose",
  "Caddy",
  "Cloudflare Tunnel",
  "Portainer",
  "nginx",
  "SSH",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="description"
      content="Portfolio of Michail Khasaev — mathematics graduate focused on data, systems and infrastructure."
    />

    <meta name="viewport" content="width=device-width" />

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;

      const theme = savedTheme ?? (prefersDark ? "dark" : "light");

      document.documentElement.dataset.theme = theme;
    </script>

    <title>Michail Khasaev</title>
  </head>

  <body>
    <header>
      <div class="shell header-inner">
        <a class="name" href="#top">Michail Khasaev</a>

        <div class="header-actions">
          <nav aria-label="Main navigation">
            <a href="#work">Work</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
          </nav>

          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch theme"
            title="Switch theme"
          >
            <span class="theme-icon" aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="shell intro">
        <p class="status">
          <span class="status-dot"></span>
          Getting cracked with cpp
        </p>

        <h1>
          Welcome to my homelab!
        </h1>

        <p class="intro-copy">
          This site documents the projects I am building across software,
          infrastructure and data.
        </p>

        <div class="actions">
          <a class="button button-dark" href="#work">
            View work
            <span aria-hidden="true">↓</span>
          </a>

          <a
            class="button button-light"
            href="https://github.com/tjM1KE"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section id="work" class="shell section">
        <div class="section-label">
          <span>01</span>
          <p>Selected work</p>
        </div>

        <article class="project">
          <div class="project-top">
            <div>
              <p class="project-type">Infrastructure</p>
              <h2>Personal homelab</h2>
            </div>

            <p class="project-year">2026</p>
          </div>

          <p class="project-description">
            A self-hosted environment built on repurposed hardware for learning
            Linux administration, Docker, networking, reverse proxies and
            deployment workflows.
          </p>

          <div class="stack">
            {homelabStack.map((item) => <span>{item}</span>)}
          </div>

          <div class="project-details">
            <div>
              <p class="detail-label">What it does</p>

              <p>
                Runs containerised services behind a Cloudflare Tunnel and
                Caddy reverse proxy, managed remotely through SSH and VS Code.
              </p>
            </div>

            <div>
              <p class="detail-label">Why I built it</p>

              <p>
                To learn infrastructure by operating a real server rather than
                relying only on tutorials or temporary cloud environments.
              </p>
            </div>
          </div>

          <a
            class="text-link"
            href="https://github.com/tjM1KE/homelab"
            target="_blank"
            rel="noreferrer"
          >
            View repository
            <span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="project upcoming">
          <div class="project-top">
            <div>
              <p class="project-type">Projects</p>
              <h2>More work coming soon</h2>
            </div>

            <p class="project-year">Next</p>
          </div>

          <p class="project-description">
            New projects will be added when they are complete, working and
            properly documented.
          </p>
        </article>
      </section>

      <section id="about" class="shell section">
        <div class="section-label">
          <span>02</span>
          <p>About</p>
        </div>

        <div class="about-grid">
          <div>
            <h2>
              I try to build to work, not to wow.
            </h2>
          </div>

          <div class="about-copy">
            <p>
              I studied Mathematics at King's College London and developed a
              strong interest in data analysis, modelling and technical
              problem-solving.
            </p>

            <p>
              I am currently building practical experience across Linux,
              Docker, networking, backend systems and infrastructure
              management.
            </p>
          </div>
        </div>

        <div class="skills">
          {skills.map((skill) => <span>{skill}</span>)}
        </div>
      </section>

      <section id="contact" class="shell section contact-section">
        <div class="section-label">
          <span>03</span>
          <p>Contact</p>
        </div>

        <div class="contact-box">
          <div>
            <p class="small-label">Get in touch</p>

            <h2>Open to relevant roles and conversations.</h2>
          </div>

          <div class="contact-actions">
            <a class="button button-dark" href="mailto:michaelkhasaev@gmail.com">
              Email me
              <span aria-hidden="true">↗</span>
            </a>

            <a
              class="button button-light"
              href="https://www.linkedin.com/in/michail-khasaev/"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <p>Michail Khasaev</p>
        <p>Built with Astro. Hosted on my homelab.</p>
      </div>
    </footer>

    <script>
      const toggle =
        document.querySelector<HTMLButtonElement>(".theme-toggle");

      function updateThemeButton(theme: string) {
        if (!toggle) return;

        const nextTheme = theme === "dark" ? "light" : "dark";

        toggle.setAttribute(
          "aria-label",
          `Switch to ${nextTheme} mode`
        );

        toggle.setAttribute(
          "title",
          `Switch to ${nextTheme} mode`
        );
      }

      const currentTheme =
        document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "light";

      updateThemeButton(currentTheme);

      toggle?.addEventListener("click", () => {
        const activeTheme =
          document.documentElement.dataset.theme === "dark"
            ? "dark"
            : "light";

        const nextTheme =
          activeTheme === "dark" ? "light" : "dark";

        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);

        updateThemeButton(nextTheme);
      });
    </script>
  </body>
</html>

<style>
  :global(:root) {
    --background: #f4f4f0;
    --surface: #e9e9e4;
    --surface-soft: rgb(255 255 255 / 38%);
    --surface-hover: #ffffff;

    --text: #111111;
    --text-muted: #565656;
    --text-soft: #777777;

    --border: rgb(17 17 17 / 14%);
    --border-strong: #111111;

    --header-background: rgb(244 244 240 / 88%);
    --shadow: rgb(17 17 17 / 12%);

    color-scheme: light;
  }

  :global(:root[data-theme="dark"]) {
    --background: #111310;
    --surface: #1b1e19;
    --surface-soft: rgb(255 255 255 / 4%);
    --surface-hover: #242822;

    --text: #f1f1eb;
    --text-muted: #b2b5ac;
    --text-soft: #858a80;

    --border: rgb(255 255 255 / 13%);
    --border-strong: #e8e9e3;

    --header-background: rgb(17 19 16 / 88%);
    --shadow: rgb(0 0 0 / 32%);

    color-scheme: dark;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.55;
    text-rendering: optimizeLegibility;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  :global(a) {
    color: inherit;
  }

  :global(button) {
    font: inherit;
  }

  :global(::selection) {
    background: var(--text);
    color: var(--background);
  }

  .shell {
    width: min(1080px, calc(100% - 40px));
    margin-inline: auto;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--header-background);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .name {
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  nav a {
    position: relative;
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms ease;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .theme-toggle {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    transform: rotate(12deg);
  }

  .theme-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .intro {
    min-height: 72vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 56px;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1f9d55;
    box-shadow: 0 0 0 5px rgb(31 157 85 / 10%);
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 950px;
    margin-bottom: 26px;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  h1 span {
    color: var(--text-soft);
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .intro-copy {
    max-width: 650px;
    margin-bottom: 32px;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  .button span {
    transition: transform 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--shadow);
  }

  .button:hover span {
    transform: translate(2px, -2px);
  }

  .button-dark {
    background: var(--text);
    color: var(--background);
  }

  .button-dark:hover {
    opacity: 0.88;
  }

  .button-light {
    background: transparent;
    color: var(--text);
  }

  .button-light:hover {
    background: var(--surface-hover);
  }

  .section {
    padding-block: 72px;
    border-top: 1px solid var(--border);
  }

  .section-label {
    display: grid;
    grid-template-columns: 70px 1fr;
    margin-bottom: 40px;
    color: var(--text-soft);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .section-label p {
    margin-bottom: 0;
  }

  .project {
    padding: 32px 0;
    border-top: 1px solid var(--border-strong);
  }

  .project + .project {
    margin-top: 48px;
  }

  .project-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 28px;
  }

  .project-type,
  .detail-label,
  .small-label {
    margin-bottom: 10px;
    color: var(--text-soft);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project-year {
    margin: 6px 0 0;
    color: var(--text-soft);
    font-size: 0.86rem;
  }

  .project-description {
    max-width: 760px;
    margin-bottom: 28px;
    color: var(--text-muted);
    font-size: 1.06rem;
  }

  .stack,
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack {
    margin-bottom: 38px;
  }

  .stack span,
  .skills span {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-soft);
    padding: 8px 13px;
    color: var(--text-muted);
    font-size: 0.82rem;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .stack span:hover,
  .skills span:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    transform: translateY(-2px);
  }

  .project-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 50px;
    margin-bottom: 32px;
  }

  .project-details p:last-child {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span {
    transition: transform 180ms ease;
  }

  .text-link:hover span {
    transform: translate(3px, -3px);
  }

  .upcoming {
    opacity: 0.64;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 80px;
    margin-bottom: 32px;
  }

  .about-copy {
    color: var(--text-muted);
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .contact-section {
    padding-bottom: 90px;
  }

  .contact-box {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    padding: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--surface);
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .contact-box h2 {
    max-width: 620px;
  }

  footer {
    border-top: 1px solid var(--border);
    padding-block: 30px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    color: var(--text-soft);
    font-size: 0.8rem;
  }

  .footer-inner p {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .shell {
      width: min(100% - 28px, 1080px);
    }

    .header-inner {
      min-height: 64px;
    }

    .header-actions {
      gap: 12px;
    }

    nav {
      gap: 14px;
    }

    nav a {
      font-size: 0.82rem;
    }

    .theme-toggle {
      width: 34px;
      height: 34px;
    }

    .intro {
      min-height: auto;
      padding-block: 80px;
    }

    h1 {
      font-size: clamp(3.2rem, 17vw, 5rem);
    }

    .section {
      padding-block: 60px;
    }

    .section-label {
      grid-template-columns: 48px 1fr;
      margin-bottom: 34px;
    }

    .project-top,
    .contact-box {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-details,
    .about-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .about-grid {
      margin-bottom: 32px;
    }

    .contact-box {
      padding: 30px;
    }

    .footer-inner {
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    :global(*) {
      transition: none !important;
    }
  }
</style>